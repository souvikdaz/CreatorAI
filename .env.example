# YouTube Data API v3 (Public Data)
# Get your API key from Google Cloud Console -> APIs & Services -> Credentials
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# YouTube Analytics API (Private Channel Data via OAuth 2.0)
# Download client_secrets.json from Google Cloud Console (OAuth 2.0 Client ID for Desktop App)
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_OAUTH_TOKEN_FILE=token.json

# Optional: Run strictly in mock mode even if API keys are set
USE_MOCK_DATA=false
